# Backend
DATABASE_URL=postgresql+psycopg2://zoiko:zoiko@localhost:5433/zoiko_local
# Generate a real one for any non-development environment, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The backend refuses to start outside development with this placeholder still set.
JWT_SECRET_KEY=change-me-in-real-env
ENVIRONMENT=development
# Comma-separated, no spaces needed (they're trimmed) - the real deployed
# frontend origin(s) in production. Must not include "*".
ALLOWED_ORIGINS=http://localhost:3000

# Google Sign-In — Client ID only, from console.cloud.google.com (Credentials)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Twilio (integrations/telecom) — get free trial credentials from twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_TRIAL_NUMBER=

# Public HTTPS URL this API is reachable at — an ngrok tunnel in dev (ngrok.com,
# free), or the real deployed origin in production. Needed for Twilio/LiveKit
# to call our webhooks back.
PUBLIC_BASE_URL=

# LiveKit (integrations/video) — get free Cloud project credentials from
# cloud.livekit.io (Settings -> Keys)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# S3-compatible storage (integrations/storage) — used only for video call
# recording uploads. Works with real AWS S3 (leave S3_ENDPOINT empty) or any
# S3-compatible provider, e.g. Backblaze B2 (free tier, no card required) or
# Cloudflare R2.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto

# Groq (integrations/transcription, integrations/llm) — free API key from
# console.groq.com. Powers AI voicemail/call summaries and receptionist
# qualification.
GROQ_API_KEY=

# Stripe Identity (integrations/kyc) — free sandbox account from stripe.com.
# STRIPE_SECRET_KEY: Developers -> API keys -> Secret key (sk_test_...).
# STRIPE_IDENTITY_WEBHOOK_SECRET: Developers -> Webhooks -> add an endpoint
# pointed at PUBLIC_BASE_URL + /compliance/webhooks/stripe-identity,
# listening for identity.verification_session.* events -> copy its
# signing secret (whsec_...).
STRIPE_SECRET_KEY=
STRIPE_IDENTITY_WEBHOOK_SECRET=

# Resend (integrations/notifications) - free account from resend.com.
# RESEND_API_KEY: Dashboard -> API Keys.
# EMAIL_FROM_ADDRESS: onboarding@resend.dev works immediately with no setup;
# switch to an address on your own domain (e.g. notifications@yourdomain.com)
# once that domain is added and verified under Dashboard -> Domains.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=onboarding@resend.dev

# Web Push (integrations/notifications/webpush.py) — browser push
# notifications, since no native iOS/Android app exists. Self-generated,
# not a third-party vendor credential:
#   python -c "from py_vapid import Vapid02; v = Vapid02(); v.generate_keys(); ..."
# (see the one-off keygen script used to produce this repo's own keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=admin@zoikogroup.com

# Event bus (integrations/eventbus/kafka.py) — local Kafka via
# `docker compose up -d kafka` (see docker-compose.yml, KRaft single-node,
# no Zookeeper). Blank disables publishing (falls back to logging).
KAFKA_BOOTSTRAP_SERVERS=localhost:9095
